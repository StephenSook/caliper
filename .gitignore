# Private research material never reaches GitHub (standing ~/dev convention).
# The repo tracks code only. Stage named paths, never git add -A.
*.pdf
*.docx
*.doc
*.pptx
*.zip
/research/
CALIPER_BUILD_SPEC.md
/frontend doc
/AI Competition Case Study*
/CALIPER_Team_Briefing*
/ResultsCX*

# Competition-confidential ResultsCX case package.
# Raw evaluator comments, agent names, member ids, participation ids, call ids
# NEVER reach a repo, a screenshot, a slide, or a demo. Synthetic data only.
/case-package/
/data/raw/

# The de-identified export. It carries no identifier, which is proven by
# scripts/check_deidentified.py, but it is still DERIVED from the confidential
# case package and it is not synthetic, so it does not belong in a public
# repository. It is generated locally and handed to a host out of band.
/data/deidentified/
*.xlsx
*.xls
*.csv
!**/synthetic/*.csv
!**/fixtures/*.csv

# Env + secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12

# Deps + build
node_modules/
.next/
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
cdk.out/
coverage/
htmlcov/
.coverage
playwright-report/
test-results/

# OS/IDE
.DS_Store
.vscode/
.idea/
*.log

# Private working files (strategy + agent instructions stay local)
/CLAUDE.md
/AGENTS.md
.claude/
/docs/private/

# Runtime state, not source. .runs/ holds the SQLite run store and the current
# tunnel address; the egg-info directory is a build artifact of the editable
# install. Neither belongs in history, and an untracked file is no protection.
.runs/
*.egg-info/

# Signing material. The real keystore lives outside this tree entirely; these
# patterns exist so a stray copy inside it can never be staged. An Android
# signing key cannot be rotated after release, so a leak is permanent.
*.jks
*.keystore
keystore.properties
*.p8
*.p12
*.mobileprovision

# Recorded demo footage. Large, and a screen capture of a run shows the supplied
# case package rendered on screen, which does not belong in a public repository
# however de-identified the interface is.
artifacts/

# Serena's project memories. Useful locally and findable in Finder at
# .serena/memories, but tooling state rather than product, and not something a
# public repository needs.
.serena/

# Playwright MCP session artifacts
.playwright-mcp/
