# CALIPER environment. No secrets are committed. Copy to .env and fill locally.
AWS_REGION=us-east-1

# Bedrock model ids. The v1 speech model reached end of life on 2026-09-14 and
# its requests now fail, so the voice path must use the Nova 2 identifier.
CALIPER_VOICE_MODEL_ID=amazon.nova-2-sonic-v1:0
CALIPER_TEXT_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Where the supplied case exports live. Never committed, never leaves the machine.
CALIPER_DATA_DIR=data/raw

# Optional. Fixes the pseudonym mapping across runs for a reproducible demo.
# Leave unset in production so each run gets a fresh salt.
CALIPER_PSEUDONYM_SALT=
